{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["WSDL_URL", "NAMESPACE"],
  "properties": {
    "WSDL_URL": { "type": "string" },
    "NAMESPACE": { "type": "string" },
    "HEADERS": { "type": "object" },
    "OPERATIONS": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "properties": {
            "SOAPAction": { "type": "string" },
            "HEADERS": { "type": "object" },
            "DEFAULT_ARGS": { "type": "object" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}